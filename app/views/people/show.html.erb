<% content_for :title, "#{@person.name} · Growth Log" %>
<% content_for :main_class, "container-wide" %>
<%# GL-15: sección de la navegación, también cuando la ficha se muestra con errores del formulario completo. %>
<% content_for :nav_section, "people" %>

<p class="back-link"><%= link_to "← Volver a Personas", people_path %></p>

<div class="person-header">
  <h1><%= @person.name %></h1>
  <p class="person-meta"><%= person_role_and_team(@person) %></p>
  <%# GL-13 (P-38): el mismo aviso breve que el listado, una sola vez y sin panel «Quién ve qué». %>
  <p class="privacy-note">Ves solo a quienes tenés asignados y las entradas que podés ver</p>

  <div class="person-actions">
    <%# GL-06: la captura se abre en una página propia (P-22). Acción principal de la ficha (GL-13). %>
    <p class="primary-action"><%= link_to "Captura rápida", new_person_feedback_entry_path(@person), class: "button button-primary" %></p>
    <%# GL-15: acción secundaria común; abre el formulario completo en el frame de la ficha, o como página sin JavaScript. %>
    <p class="secondary-action"><%= link_to "+ Feedback", person_complete_feedback_entry_path(@person), class: "button", data: { turbo_frame: "feedback_form" } %></p>
  </div>
</div>

<%# GL-15: el formulario completo se abre acá. Vacío salvo al volver con errores de validación. %>
<%= turbo_frame_tag "feedback_form" do %>
  <% if @complete_entry %>
    <%= render "feedback_entries/complete_form", person: @person, entry: @complete_entry %>
  <% end %>
<% end %>

<%# GL-13 (R-4): cronología y resumen en dos columnas desde 64 rem; más angosto, el resumen va primero. %>
<div class="person-columns">

<%# Resumen por dimensión (GL-07): solo entradas propias listas (4.1, P-2, 3.3, 4.4, 4.5). %>
<section class="summary" data-summary aria-labelledby="summary-title">
  <h2 id="summary-title">Resumen por dimensión</h2>
  <% if @summary.empty? %>
    <p class="empty-state">Todavía no hay entradas listas para el resumen.</p>
  <% else %>
    <div class="table-wrap">
      <table class="summary-table">
        <thead>
          <tr>
            <th scope="col">Dimensión</th>
            <th scope="col">Positivos</th>
            <th scope="col">A mejorar</th>
            <th scope="col">Neutrales</th>
            <th scope="col">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @summary.rows.each do |row| %>
            <tr>
              <th scope="row"><%= row.label %></th>
              <td><%= row.positive %></td>
              <td><%= row.improvement %></td>
              <td><%= row.neutral %></td>
              <td><%= row.total %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="summary-note">Solo entradas listas. No es un puntaje: reúne evidencia para la conversación.</p>
  <% end %>
</section>

<%# Cronología (GL-07, P-10): todas las entradas propias, borradores incluidos; reemplaza la sección de P-21. %>
<section class="timeline" data-timeline aria-labelledby="timeline-title">
  <h2 id="timeline-title">Vista cronológica</h2>
  <% if @timeline.any? %>
    <ul class="entries">
      <% @timeline.each do |entry| %>
        <li>
          <%= link_to feedback_entry_path(entry), class: "entry-row", data: { status: entry.status } do %>
            <span class="entry-row-date"><%= entry_date(entry.occurred_on) %></span>
            <span class="entry-row-status"><%= timeline_status_label(entry) %></span>
            <% if entry.signal_label %><span class="entry-row-tag entry-row-signal signal-<%= entry.signal %>"><%= entry.signal_label %></span><% end %>
            <% if entry.dimension_label %><span class="entry-row-tag entry-row-dimension"><%= entry.dimension_label %></span><% end %>
            <span class="entry-row-text"><%= entry.context.length > 80 ? "#{entry.context.first(80)}…" : entry.context %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">Todavía no registraste entradas sobre <%= @person.name %>.</p>
  <% end %>
</section>
</div>
