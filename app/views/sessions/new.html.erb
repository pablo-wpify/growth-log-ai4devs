<% content_for :title, "Iniciar sesión · Growth Log" %>

<h1>Iniciar sesión</h1>

<%# Aviso genérico (GL-02): no indica qué dato falló ni marca un campo (GL-11). %>
<% if flash[:alert] %>
  <div class="error-summary" role="alert"><%= flash[:alert] %></div>
<% end %>

<%# Presentación (GL-11, P-32 y P-33): etiquetas sobre los campos, ancho máximo de 24 rem. %>
<%= form_with url: session_path, class: "sign-in-form" do |form| %>
  <div class="field">
    <%= form.label :email_address, "Correo" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>
  <div class="field">
    <%= form.label :password, "Contraseña" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <%= form.submit "Iniciar sesión" %>
<% end %>
