# Plantilla de variables locales de Growth Log. No contiene secretos.
# Copiala a .env (ignorado por Git) y reemplazá el marcador de la contraseña:
#   cp .env.example .env
# Cargala en cada terminal antes de usar Rails:
#   set -a; . ./.env; set +a
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55440
DATABASE_USERNAME=growth_log
DATABASE_PASSWORD=reemplazar-por-una-contraseña-local

# Contenedor local de PostgreSQL 18.6 (ver docs/desarrollo.md). Puerto solo en 127.0.0.1.
GROWTH_LOG_PG_CONTAINER=growthlog-pg
GROWTH_LOG_PG_VOLUME=growthlog-pgdata
